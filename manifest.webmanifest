      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/snake.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/memory.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/icons/egg.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "form_factor": "wide"
    },
    {
      "src": "./assets/icons/egg.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "form_factor": "narrow"
    }
  ]
